<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>orchard_planning</name>
  <version>0.1.0</version>
  <description>과수원 전역 경로계획(통로 순회 + Hybrid A*)과 지역 경로계획(DWA, 장애물 회피)</description>
  <maintainer email="pathcmd@gmail.com">UNIST BTS 유니주행차</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>orchard_msgs</exec_depend>
  <exec_depend>orchard_navigation</exec_depend>
  <exec_depend>orchard_perception</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>orchard_perception</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
